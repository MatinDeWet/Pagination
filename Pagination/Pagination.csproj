<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>


	<!-- NuGet Package Information -->
	<PackageId>MatinDeWet.Pagination</PackageId>
	<Version>1.0.0</Version>
	<Authors>MatinDeWet</Authors>
	<Description>Offset and cursor pagination helpers for Entity Framework Core queries.</Description>
	<PackageTags>pagination;cursor;efcore;entityframework</PackageTags>
	<PackageProjectUrl>https://github.com/MatinDeWet/Pagination</PackageProjectUrl>
	<PackageIcon>icon.png</PackageIcon>

	<!-- GPL-3.0 License -->
	<PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>

	<PackageReadmeFile>README.md</PackageReadmeFile>
	<RepositoryUrl>https://github.com/MatinDeWet/Pagination</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<PublishRepositoryUrl>true</PublishRepositoryUrl>
	<EmbedUntrackedSources>true</EmbedUntrackedSources>
	<IncludeSymbols>true</IncludeSymbols>
	<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	<Deterministic>true</Deterministic>
	<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	<IsPackable>true</IsPackable>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>

	<!-- Required for GPL compliance -->
	<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
	<Copyright>Copyright © $(Authors) $([System.DateTime]::Now.Year)</Copyright>
  </PropertyGroup>

	<ItemGroup>
		<None Include="../README.md" Pack="true" PackagePath="/" />
		<None Include="../icon.png" Pack="true" PackagePath="/" Condition="Exists('../icon.png')" />
		<None Include="../LICENSE.txt" Pack="true" PackagePath="/" />
	</ItemGroup>

  <ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
